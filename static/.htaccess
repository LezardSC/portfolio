# Apache config for the OVH hosting (copied into build/ by the build).
# Every directive that needs a module is inside <IfModule>: a missing module drops that feature
# instead of failing every request with a 500. No "Options" line: OVH may not allow it.
# Locale paths (/en/, /fr/) are written here because this file has no access to base or LANGS;
# src/lib/htaccess.spec.ts fails when lang.ts changes.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On

	# 1. One canonical address: https, no www (a single 301). The host is taken from the request.
	#    SERVER_PORT, not HTTPS: OVH's front proxy can hide HTTPS from Apache (OVH's own advice).
	RewriteCond %{SERVER_PORT} ^80$ [OR]
	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteCond %{HTTP_HOST} ^(?:www\.)?([^:]+) [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

	# 2. / → the visitor's language, like pickLang(): the first of en/fr in Accept-Language wins.
	#    An item is en or fr by its leading letters (fr-CA, fr_FR; not fry); any other item, however
	#    malformed (de_DE, empty, extra parameters), is skipped. q-values are ignored, as in pickLang.
	#    302 and not cached, so a visitor changing language preferences is not stuck. Absolute
	#    https target: Apache behind the proxy may think the request is http (one hop saved).
	#    The JS redirect page at / stays as the fallback when this does not run.
	RewriteCond %{HTTP:Accept-Language} ^(?:(?!\s*(?:en|fr)(?![a-z]))[^,]*,)*\s*fr(?![a-z]) [NC]
	RewriteRule ^$ https://%{HTTP_HOST}/fr/ [R=302,L,E=LANGREDIRECT:1]
	RewriteRule ^$ https://%{HTTP_HOST}/en/ [R=302,L,E=LANGREDIRECT:1]

	# 3. A directory without its slash (/en) → /en/, before mod_dir does it: mod_dir builds the
	#    address from the port it sees and sends https://host:443/en/. The query string is kept.
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteCond %{REQUEST_URI} !/$
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
	# Caching: one week by default; HTML, sitemap, robots and the CVs revalidate on every visit, so
	# a deploy (or a new CV) shows at once; hashed files under _app/immutable never change: one year.
	Header set Cache-Control "public, max-age=604800"
	<FilesMatch "\.(html|xml|txt|pdf)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<If "%{REQUEST_URI} =~ m#/_app/immutable/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	Header always set Cache-Control "no-cache" env=LANGREDIRECT
	Header always merge Vary "Accept-Language" env=LANGREDIRECT

	# Security headers ("always": also on redirects and the 404). HSTS is raised in steps, because
	# browsers refuse plain http for the whole max-age: see "HSTS" in docs/deploy.md (issue #34).
	# No includeSubDomains and no preload for now. Browsers ignore it when received over plain http.
	Header always set Strict-Transport-Security "max-age=86400"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "DENY"
	Header always set Content-Security-Policy "frame-ancestors 'none'"
	Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
</IfModule>

<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
	</IfModule>
</IfModule>

<IfModule mod_mime.c>
	AddType font/woff2 .woff2
	AddType image/webp .webp
	AddType video/webm .webm
</IfModule>

# The deploy manifest (file hashes) is for the deploy script, not for visitors.
<IfModule mod_authz_core.c>
	<Files ".deploy-manifest.json">
		Require all denied
	</Files>
</IfModule>
