{
	"name": "portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p scripts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"audit": "node scripts/audit.ts",
		"screens": "node scripts/screens.ts",
		"og": "node scripts/og.ts",
		"budget": "node scripts/budget.ts",
		"deploy": "node --env-file-if-exists=.env.deploy scripts/deploy.ts",
		"smoke": "node scripts/smoke.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.3",
		"@types/ssh2-sftp-client": "^9.0.6",
		"lighthouse": "^13.5.0",
		"playwright": "1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"simple-icons": "^16.33.0",
		"ssh2-sftp-client": "^12.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
